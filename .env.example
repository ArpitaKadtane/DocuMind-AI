# GenAI Document Assistant - environment configuration
# Copy this file to ".env" and fill in your real values.
# NEVER commit your .env file to Git (it is gitignored).

# --- LLM (Groq, free tier) ---
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
REQUEST_TIMEOUT=30

# --- Embeddings ---
EMBEDDING_MODEL=multi-qa-MiniLM-L6-cos-v1

# --- Chunking ---
CHUNK_SIZE_CHARS=800
CHUNK_OVERLAP_CHARS=150

# --- Upload / PDF safety limits ---
MAX_UPLOAD_MB=10
MAX_PDF_PAGES=100
MAX_PDF_CHARS=2000000

# --- Retrieval ---
TOP_K=4
# Minimum similarity score (0-1) required to consider a chunk relevant.
# Below this, the app answers "not found" instead of calling the LLM.
MIN_SCORE=0.15

# --- Summaries ---
# Whole-document summaries read the document's chunks directly. If a document
# is larger than this many characters, chunks are sampled evenly across it.
SUMMARY_MAX_CHARS=12000
# Max tokens the model may use for a summary response.
SUMMARY_MAX_TOKENS=700
# Max number of key points the model should return.
SUMMARY_MAX_POINTS=8

# --- Persistence ---
# Directory for stored PDFs and the SQLite database.
# Defaults to a "data" folder next to the app package. Uncomment to override.
# DATA_DIR=/absolute/path/to/data

# --- Auth / sessions ---
# How long a login token stays valid, in hours (default: 7 days).
SESSION_TTL_HOURS=168
